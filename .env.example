# Vorlage für die Umgebungsvariablen.
# In Coolify unter "Environment Variables" eintragen (nicht diese Datei committen).

# Schützt das Statistik-Dashboard unter /stats.php — Pflicht.
# Langen Zufallswert erzeugen, z. B. mit:  openssl rand -hex 24
STATS_KEY=

# Zieladresse für Anfragen aus dem Kontaktformular
KONTAKT_EMPFAENGER=kontakt@mwart.solutions

# Absenderadresse der Benachrichtigungs-Mails
KONTAKT_ABSENDER=formular@mwart.solutions
